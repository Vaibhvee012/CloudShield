generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Resource {
  id              String   @id
  name            String
  type            String
  region          String
  status          String
  environment     String
  riskLevel       String
  source          String   @default("MANUAL")
  awsConnectionId String?

  awsConnection   AWSConnection? @relation(fields: [awsConnectionId], references: [id], onDelete: Cascade)

  findings        Finding[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([awsConnectionId])
  @@unique([awsConnectionId, type, name])
}

model Finding {
  id           String   @id
  title        String
  severity     String
  resourceId   String
  resourceType String
  region       String
  status       String
  category     String
  description  String

  resource     Resource           @relation(fields: [resourceId], references: [id])
  remediation  RemediationAction?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RemediationAction {
  id            String   @id
  findingId     String   @unique
  title         String
  action        String
  status        String
  riskReduction String

  finding       Finding  @relation(fields: [findingId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("VIEWER")

  awsConnections AWSConnection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AWSConnection {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  roleArn     String
  region      String
  status      String   @default("CONNECTED")
  lastSyncAt  DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources   Resource[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@unique([userId, accountId])
}

model SyncStatus {
  id           String   @id
  lastSyncedAt DateTime?
  updatedAt    DateTime @updatedAt
}